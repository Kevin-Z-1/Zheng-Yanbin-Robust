library(rpca)
library(forecast)
library(MASS)
library(knitr)
library(kableExtra)

# 1. Data preparation

data <- read.csv("https://raw.githubusercontent.com/Kevin-Z-1/Zheng-Yanbin-Robust/main/388_converted.csv")

colnames(data)[1] <- "date"
colnames(data) <- trimws(colnames(data))
data$date <- as.POSIXct(data$date, format = "%Y-%m-%d %H:%M:%S")
data <- subset(data, date >= as.POSIXct("1993-02-28") & date <= as.POSIXct("2024-10-31"))
data$date <- as.Date(format(data$date, "%Y-%m-01"))

log_returns <- 100 * diff(log(data$GBP.to.JPY))
data <- data[-1, ]
data$log_returns <- log_returns


# 2. Hampel Remove local outlier

hampel_filter <- function(x, window_size = 11, k = 2) {
  n <- length(x)
  x_clean <- x
  for (i in 1:n) {
    if (is.na(x[i])) next
    start <- max(1, i - window_size)
    end <- min(n, i + window_size)
    window_data <- x[start:end]
    median_val <- median(window_data, na.rm = TRUE)
    mad_val <- median(abs(window_data - median_val), na.rm = TRUE)
    lower_bound <- median_val - k * mad_val
    upper_bound <- median_val + k * mad_val
    if (!is.na(x[i]) && (x[i] < lower_bound || x[i] > upper_bound)) {
      x_clean[i] <- median_val
    }
  }
  return(x_clean)
}
hampel_log_returns <- hampel_filter(data$log_returns)


# 3. RPCA Remove local anomalies

apply_rpca <- function(series) {
  rpca_result <- rpca(as.matrix(series))
  low_rank <- as.numeric(rpca_result$L)
  return(low_rank)
}
rpca_log_returns <- apply_rpca(data$log_returns)


# 4. Differentiation to stabilize

diff_hampel_log_returns <- diff(hampel_log_returns)
diff_rpca_log_returns <- diff(rpca_log_returns)


# 5. MA and RW Model Definition

rolling_forecast_rw <- function(data, window_size, test_length) {
  forecast_results <- c()
  for (i in 1:(length(data) - window_size - test_length)) {
    last_obs <- data[i + window_size - 1]
    forecast_results <- c(forecast_results, last_obs)
  }
  return(forecast_results)
}

rolling_forecast_ma <- function(data, window_size, test_length) {
  forecast_results <- c()
  for (i in 1:(length(data) - window_size - test_length)) {
    window_mean <- mean(data[i:(i + window_size - 1)], na.rm = TRUE)
    forecast_results <- c(forecast_results, window_mean)
  }
  return(forecast_results)
}


# 6. Split training set + generate predictions

window_size <- floor(0.8 * length(diff_hampel_log_returns))
test_actual <- diff_hampel_log_returns[(window_size + 1):length(diff_hampel_log_returns)]

fc_ma_hampel <- rolling_forecast_ma(diff_hampel_log_returns, window_size, test_length = 1)
fc_ma_rpca   <- rolling_forecast_ma(diff_rpca_log_returns, window_size, test_length = 1)
fc_rw_hampel <- rolling_forecast_rw(diff_hampel_log_returns, window_size, test_length = 1)
fc_rw_rpca   <- rolling_forecast_rw(diff_rpca_log_returns, window_size, test_length = 1)


# 7. Evaluation index calculation function

calculate_sr_pt <- function(actual, predicted) {
  sr <- mean((sign(actual) == sign(predicted)) & (abs(actual - predicted) > 0.5), na.rm = TRUE)
  p_actual_up <- mean(actual > 0, na.rm = TRUE)
  p_predicted_up <- mean(predicted > 0, na.rm = TRUE)
  p_star <- p_actual_up * p_predicted_up + (1 - p_actual_up) * (1 - p_actual_up)
  if (!is.na(p_star) && p_star > 0 && p_star < 1) {
    pt <- (sr - p_star) / sqrt(p_star * (1 - p_star) / length(actual))
  } else {
    pt <- NA
  }
  return(c(SR = sr, PT = pt))
}

calculate_metrics <- function(actual, predicted) {
  valid_indices <- which(!is.na(actual) & !is.na(predicted))
  actual <- actual[valid_indices]
  predicted <- predicted[valid_indices]
  residuals <- actual - predicted
  mse <- mean(residuals^2, na.rm = TRUE)
  mad <- median(abs(residuals), na.rm = TRUE)
  mae <- mean(abs(residuals), na.rm = TRUE)
  sr_pt <- calculate_sr_pt(actual, predicted)
  return(c(MSE = mse, MAD = mad, MAE = mae, SR = sr_pt["SR"], PT = sr_pt["PT"]))
}


# 8. Evaluate

metrics_list <- list(
  Hampel_MA = calculate_metrics(test_actual, fc_ma_hampel),
  RPCA_MA   = calculate_metrics(test_actual, fc_ma_rpca),
  Hampel_RW = calculate_metrics(test_actual, fc_rw_hampel),
  RPCA_RW   = calculate_metrics(test_actual, fc_rw_rpca)
)


# 9. Output table

result_df <- data.frame(
  Model = names(metrics_list),
  do.call(rbind, metrics_list)
)

result_df <- result_df[order(result_df$MSE), ]

kable(result_df, digits = 3, caption = "Performance of MA and RW Models with Hampel and RPCA") %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"))


